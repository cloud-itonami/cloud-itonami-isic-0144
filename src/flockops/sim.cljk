(ns flockops.sim
  "Simple simulation/demo runner for the Sheep-and-Goat Farm Operations
  Coordinator actor. Used to validate that the actor flow compiles and
  basic proposal flow works. Mirrors `swineops.sim`
  (cloud-itonami-isic-0145)."
  (:require [flockops.operation :as operation]
            [flockops.store :as store]))

(defn demo
  "Run a simple demo scenario: register a facility, propose a husbandry
  record log, and check the disposition flow."
  []
  (let [;; Create store with a registered facility
        st (store/mem-store
            {:initial-facilities
             {"farm-001"
              {:id "farm-001"
               :name "Sunrise Flock Farm"
               :paddock "Paddock 4, Pen 7"
               :breed "suffolk"}}})

        ;; Build actor
        actor (operation/build st)

        ;; Create a request to log a husbandry record
        request {:op :log-husbandry-record
                 :facility-id "farm-001"
                 :count 85
                 :health-status "healthy"}

        ;; Context with phase 0 (simulation)
        context {:actor-id "flock-ops-01"
                 :role :farm-operator
                 :phase :phase-0}]

    (println "=== Sheep-and-Goat Farm Operations Coordinator Demo ===")
    (println "Demo facility: farm-001 (Paddock 4, Pen 7)")
    (println "Request: log-husbandry-record")
    (println "Phase: phase-0 (simulation)")
    (println "Expected: escalate (phase-0 forces human review of all commits)")
    (println)
    (let [result (actor request context)]
      (println "Result disposition:" (:disposition result))
      result)))

(defn -main
  "kbb -M:run entrypoint."
  [& _args]
  (demo))

(comment
  ;; In a real REPL:
  (demo)
)
